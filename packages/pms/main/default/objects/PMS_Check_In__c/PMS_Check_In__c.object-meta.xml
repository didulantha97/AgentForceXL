<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Online Check-In</label>
    <pluralLabel>Online Check-Ins</pluralLabel>
    <description
  >Details a guest or tenant sent before arrival or move-in (online check-in).</description>
    <nameField><label>Check-In Number</label><displayFormat
    >CI-{000000}</displayFormat><startingNumber>1</startingNumber><type
    >AutoNumber</type><trackHistory>false</trackHistory></nameField>
