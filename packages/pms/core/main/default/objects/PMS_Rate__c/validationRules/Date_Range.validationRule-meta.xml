<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Date_Range</fullName>
    <active>true</active>
    <description>Rate Date To cannot be before Date From.</description>
    <errorConditionFormula
  >AND(NOT(ISBLANK(Date_From__c)), NOT(ISBLANK(Date_To__c)), Date_To__c &lt; Date_From__c)</errorConditionFormula>
    <errorDisplayField>Date_To__c</errorDisplayField>
    <errorMessage>Date To cannot be before Date From.</errorMessage>
</ValidationRule>
