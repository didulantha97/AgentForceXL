<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Agent Rich Output</masterLabel>
    <description
  >Displays an Agentforce structured response as a polished rich-text report.</description>
    <targets>
        <target>lightning__FlowScreen</target>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property
        name="agentResponse"
        type="String"
        label="Agent Response (Recommended)"
        description="Map the Agentforce agentResponse output here."
        role="inputOnly"
      />
            <property
        name="structuredAgentResponse"
        type="String"
        label="Structured Agent Response (Legacy)"
        description="Optional compatibility input for actions that expose structuredAgentResponse."
        role="inputOnly"
      />
            <property
        name="title"
        type="String"
        label="Title"
        default="Binance Market Analysis"
        role="inputOnly"
      />
            <property
        name="subtitle"
        type="String"
        label="Subtitle"
        role="inputOnly"
      />
            <property
        name="showRawResponse"
        type="Boolean"
        label="Show Raw Response"
        default="false"
        role="inputOnly"
      />
        </targetConfig>
        <targetConfig
      targets="lightning__RecordPage,lightning__AppPage,lightning__HomePage"
    >
            <property
        name="agentResponse"
        type="String"
        label="Agent Response"
      />
            <property
        name="structuredAgentResponse"
        type="String"
        label="Structured Agent Response"
      />
            <property
        name="title"
        type="String"
        label="Title"
        default="Binance Market Analysis"
      />
            <property name="subtitle" type="String" label="Subtitle" />
            <property
        name="showRawResponse"
        type="Boolean"
        label="Show Raw Response"
        default="false"
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
