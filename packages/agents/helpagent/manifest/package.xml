<?xml version="1.0" encoding="UTF-8" ?>
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Agent container (the agent itself) -->
    <types>
        <members>*</members>
        <name>Bot</name>
    </types>
    <types>
        <members>*</members>
        <name>BotVersion</name>
    </types>

    <!-- Agent planner / reasoning config (API 64.0+ uses the Bundle type) -->
    <types>
        <members>*</members>
        <name>GenAiPlannerBundle</name>
    </types>

    <!-- Topics -->
    <types>
        <members>*</members>
        <name>GenAiPlugin</name>
    </types>

    <!-- Agent actions -->
    <types>
        <members>*</members>
        <name>GenAiFunction</name>
    </types>

    <!-- Prompt Builder templates -->
    <types>
        <members>*</members>
        <name>GenAiPromptTemplate</name>
    </types>
    <types>
        <members>*</members>
        <name>GenAiPromptTemplateActv</name>
    </types>

    <!-- Agent Script agents (newer Agentforce builder), if you use them -->
    <types>
        <members>*</members>
        <name>AiAuthoringBundle</name>
    </types>

    <!-- Things actions typically call -->
    <types>
        <members>*</members>
        <name>Flow</name>
    </types>
    <types>
        <members>*</members>
        <name>ApexClass</name>
    </types>

    <version>67.0</version>
</Package>
