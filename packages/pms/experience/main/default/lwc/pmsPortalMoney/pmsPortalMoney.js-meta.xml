<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>PMS My Payments</masterLabel>
    <description
  >Customer portal: invoices to pay with reminder stage and Pay button, payment-plan instalments, bookings that need a card or deposit, and notified rent changes.</description>
