    <description
  >Finds an active PMS site by part of its name and returns its Id, module and plain-text lists of room/unit types, practitioners and bookable services (with Ids). Used by the PMS Concierge agent.</description>
    <formulas>
        <name>practitionerLine</name>
        <dataType>String</dataType>
        <expression
    >{!Loop_Practitioners.Name} &amp; &quot; [practitionerId &quot; &amp; {!Loop_Practitioners.Id} &amp; &quot;]: &quot; &amp; BLANKVALUE({!Loop_Practitioners.Speciality__c}, &quot;&quot;) &amp; &quot;, hours &quot; &amp; BLANKVALUE({!Loop_Practitioners.Working_Hours__c}, &quot;-&quot;) &amp; &quot;. &quot;</expression>
    </formulas>
    <formulas>
        <name>serviceLine</name>
        <dataType>String</dataType>
        <expression
    >{!Loop_Services.Name} &amp; &quot; [serviceId &quot; &amp; {!Loop_Services.Id} &amp; &quot;]: &quot; &amp; TEXT({!Loop_Services.Duration_Minutes__c}) &amp; &quot; min, &quot; &amp; TEXT({!Loop_Services.Price__c}) &amp; &quot;. &quot;</expression>
    </formulas>
    <formulas>
        <name>siteLine</name>
        <dataType>String</dataType>
        <expression
    >{!site.Name} &amp; &quot;, &quot; &amp; BLANKVALUE({!site.Street__c}, &quot;&quot;) &amp; &quot; &quot; &amp; BLANKVALUE({!site.City__c}, &quot;&quot;) &amp; &quot;. Module: &quot; &amp; TEXT({!site.Module__c}) &amp; &quot;. Currency: &quot; &amp; BLANKVALUE({!site.Currency_Code__c}, &quot;&quot;) &amp; &quot;. Phone: &quot; &amp; BLANKVALUE({!site.Phone__c}, &quot;-&quot;)</expression>
    </formulas>
    <formulas>
        <name>spaceTypeLine</name>
        <dataType>String</dataType>
        <expression
    >{!Loop_Space_Types.Name} &amp; &quot; [spaceTypeId &quot; &amp; {!Loop_Space_Types.Id} &amp; &quot;]: from &quot; &amp; TEXT({!Loop_Space_Types.Default_Rate__c}) &amp; &quot; per night, up to &quot; &amp; TEXT({!Loop_Space_Types.Default_Occupancy__c}) &amp; &quot; guests. &quot;</expression>
    </formulas>
