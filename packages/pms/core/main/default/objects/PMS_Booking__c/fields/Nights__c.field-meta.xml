<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Nights__c</fullName>
    <description>Number of nights or days between start and end.</description>
    <externalId>false</externalId>
    <formula
  >IF(OR(ISBLANK(Start__c), ISBLANK(End__c)), NULL, DATEVALUE(End__c) - DATEVALUE(Start__c))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Calculated from Start and End.</inlineHelpText>
    <label>Nights</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
