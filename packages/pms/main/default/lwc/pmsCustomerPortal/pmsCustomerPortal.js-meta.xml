<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>PMS Customer Portal</masterLabel>
    <description
  >Overview, bookings, invoices with Stripe pay-now, and service requests for the logged-in customer.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
        name="defaultTab"
        type="String"
        label="Tab to open first"
        datasource="overview,bookings,invoices,requests"
        default="overview"
      />
            <property
        name="showHeader"
        type="Boolean"
        label="Show welcome header"
        default="false"
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
