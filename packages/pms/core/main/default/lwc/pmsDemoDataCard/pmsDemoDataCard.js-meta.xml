<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>PMS Demo Data</masterLabel>
    <description
  >Admin-only card to load and remove demo data packs (sandbox, scratch, trial and Developer Edition orgs). Hides itself in production and for non-admins.</description>
    <targets>
        <target>lightning__HomePage</target>
        <target>lightning__AppPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__HomePage,lightning__AppPage">
            <property
        name="cardTitle"
        type="String"
        label="Card title"
        default="Demo data"
      />
            <property
        name="refreshSeconds"
        type="Integer"
        label="Refresh while loading (seconds)"
        default="10"
        min="2"
        max="30"
      />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
